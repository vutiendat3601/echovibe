user nginx;
worker_processes auto;

error_log /app/log/error.log notice;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/json;

  log_format main '[$time_iso8601]: Request="$request",IP="$remote_addr",UserAgent="$http_user_agent",Status=$status,'
                      'BodyBytesSent=$body_bytes_sent,Referrer="$http_referer",XForwardedFor="$http_x_forwarded_for"'
  access_log /app/log/access.log main;

  sendfile on;
  gzip on;
  keepalive_timeout 65;

  server {
    listen 80;
    server_name localhost;

    root /app/echovibe-adminweb/browser;
    index index.html;

    if ($accept_language ~ "^$") {
      set $accept_language "en";
    }
    rewrite ^/$ /$accept_language permanent;

    location ~ ^/(en|vi|$) {
      try_files $uri /$1/index.html?$args;
    }
  }
}
