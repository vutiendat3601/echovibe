global:
  namespace: microservice
  springProfilesActive: default
  kafkaBrokerUrls: http://infras.echovibe.io.vn:9092
  openIdConnectCertsUrl: https://auth.echovibe.io.vn/realms/echovibe/protocol/openid-connect/certs
  namespace: microservice
  gatewayName: microservice
deployment:
  name: springbootapp
  image: 
    repository: repository
    tag: latest
    pullPolicy: Always
  containerPort: 6100
  replicaCount: 3
  service:
    type: ClusterIP
    port: 80
    targetPort: 8080
    protocol: TCP
    hostname: api.echovibe.io.vn
    exposePathPrefix: /command/v1/artists
    replacePrefixMatch: /v1/artists
kafka:
  enabled: false
openidconnect:
  enabled: false
mongo:
  enabled: false
  uri: 
datasource:
  enabled: false
  url:
  username:
  password:
