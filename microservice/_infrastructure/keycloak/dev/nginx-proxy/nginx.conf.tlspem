user nginx;
worker_processes auto;

error_log /app/log/error.log notice;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/json;

  log_format main '[$time_iso8601]: Request="$request",IP="$remote_addr",UserAgent="$http_user_agent",Status=$status,'
                      'BodyBytesSent=$body_bytes_sent,Referrer="$http_referer",XForwardedFor="$http_x_forwarded_for"'
#   access_log /app/log/access.log main;
  
  sendfile on;
  gzip on;
  keepalive_timeout 65;

  upstream echovibe-keycloak {
    server echovibe-keycloak-i1:6810;
  }

  server {
    listen 80;
    server_name auth.echovibe.io.vn www.auth.echovibe.io.vn;
    return 301 https://$host$request_uri;
  }

  server {
    listen 443 ssl;
    server_name auth.echovibe.io.vn www.auth.echovibe.io.vn;

    ssl_certificate /app/tls/certificate.pem;
    ssl_certificate_key /app/tls/private.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;
  
    location / {
      proxy_pass http://echovibe-keycloak;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_ssl_verify off;
    }
  }
}
