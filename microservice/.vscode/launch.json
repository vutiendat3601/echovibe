{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "product",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/product",
      "args": [
        "app.main:app",
        "--reload",
        "--port=6200"
      ],
      "jinja": true
    },
    {
      "type": "java",
      "name": "ArtistCommandApplication",
      "request": "launch",
      "mainClass": "vn.io.echovibe.artist.command.ArtistCommandApplication",
      "projectName": "artistcommand",
      "cwd": "${workspaceFolder}/artistcommand"
    },
    {
      "type": "java",
      "name": "ArtistQueryApplication",
      "request": "launch",
      "mainClass": "vn.io.echovibe.artist.query.ArtistQueryApplication",
      "projectName": "artistquery",
      "cwd": "${workspaceFolder}/artistquery"
    }
  ]
}