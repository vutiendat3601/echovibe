{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "artistquery",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/artistquery",
      "args": ["app.main:app", "--reload", "--port=6110"],
      "jinja": true,
      "envFile": "${workspaceFolder}/artistquery/.env"
    },
    {
      "name": "product",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/product",
      "args": ["app.main:app", "--reload", "--port=6200"],
      "jinja": true,
      "envFile": "${workspaceFolder}/product/.env"
    },
    {
      "type": "java",
      "name": "ArtistCommandApplication",
      "request": "launch",
      "mainClass": "vn.io.echovibe.artist.command.ArtistCommandApplication",
      "projectName": "artistcommand",
      "cwd": "${workspaceFolder}/artistcommand"
    },
    {
      "type": "java",
      "name": "TrackCommandApplication",
      "request": "launch",
      "mainClass": "vn.io.echovibe.track.command.TrackCommandApplication",
      "projectName": "trackcommand",
      "cwd": "${workspaceFolder}/trackcommand"
    },
  ]
}
