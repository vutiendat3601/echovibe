{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "artistquery",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/artistquery",
      "args": [
        "app.main:app",
        "--reload",
        "--port=6110"
      ],
      "jinja": true,
      "envFile": "${workspaceFolder}/artistquery/.env",
      "justMyCode": false
    },
    {
      "type": "java",
      "name": "ArtistCommandApplication",
      "request": "launch",
      "mainClass": "vn.io.echovibe.artist.command.ArtistCommandApplication",
      "projectName": "artistcommand",
      "cwd": "${workspaceFolder}/artistcommand",
      "env": {
        "APP_WEB_CLIENT_ARTISTQUERY_BASEURL": "http://localhost:6110"
      }
    },
    {
      "name": "trackquery",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/trackquery",
      "args": [
        "app.main:app",
        "--reload",
        "--port=6130"
      ],
      "jinja": true,
      "envFile": "${workspaceFolder}/trackquery/.env",
      "justMyCode": false
    },
    {
      "type": "java",
      "name": "TrackCommandApplication",
      "request": "launch",
      "mainClass": "vn.io.echovibe.track.command.TrackCommandApplication",
      "cwd": "${workspaceFolder}/trackcommand",
      "projectName": "trackcommand"
    },
    {
      "name": "product",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/product",
      "args": [
        "app.main:app",
        "--reload",
        "--port=6200"
      ],
      "jinja": true,
      "envFile": "${workspaceFolder}/product/.env",
      "justMyCode": false
    }
  ]
}